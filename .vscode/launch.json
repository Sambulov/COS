        {
            "name": "Remote OOCD Debug",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "Start remote OpenOCD",
            "postDebugTask": "Stop remote OpenOCD",
            "servertype": "external",
			"cwd": "${workspaceFolder}",
			"executable": "./build/firmware.elf",
            //"interface": "swd",
			"device": "${config:MCU}",
            //"showDevDebugOutput": "parsed",
