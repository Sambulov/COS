{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "OOCD Flash NUM463KG",
            "linux": {
				"command": "/home/NuOpenOCD/bin/openocd",
			},
			"windows": {
                "command": "C:/NuOpenOCD/bin/openocd.exe",
			},
            "args": [
                "-f", "${workspaceFolder}/HDL/McuPort/ARM/Nuvoton/NUM46X/Res/tool.cfg",
                "-f", "${workspaceFolder}/HDL/McuPort/ARM/Nuvoton/NUM46X/Res/HDL/McuPort/ARM.cfg",
                "-c", "init",
                "-c", "halt",
                "-c", "flash write_image erase ./build/bmc.hex",
                "-c", "reset run",
                "-c", "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "type": "shell",
            "label": "OOCD Erase NUM463KG",
            "linux": {
				"command": "/home/NuOpenOCD/bin/openocd",
			},
			"windows": {
                "command": "C:/NuOpenOCD/bin/openocd.exe",
			},
            "args": [
                "-f", "${workspaceFolder}/HDL/McuPort/ARM/Nuvoton/NUM46X/Res/tool.cfg",
                "-f", "${workspaceFolder}/HDL/McuPort/ARM/Nuvoton/NUM46X/Res/HDL/McuPort/ARM.cfg",
                "-c", "init",
                "-c", "halt",
                "-c", "flash erase_address 0x00000000 0x00040000",
                "-c", "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
		{
			"type": "shell",
			"label": "J-Link Flash",
            "linux": {
				"command": "JLinkExe -CommandFile ./build/flash.jlink",
			},
			"windows": {
				"command": "JLink.exe -CommandFile ./build/flash.jlink",
			},
			"detail": "Flash",
			"group": "build"
		},
		{
			"type": "shell",
			"label": "Run Remoute GDB",
            "linux": {
				"command": "ping 127.0.0.1",
			},
			"windows": {
				"command": "ping 127.0.0.1",
			},
		},
		{
			"type": "shell",
			"label": "Start remoute OpenOCD",
            "group": "build",
            "command": "python",
            "args": [
                "${workspaceFolder}/Tools/remoute_gdb_launch.py",
                "--server",
                "${config:REMOUTE_GDB_LAUNCHER}", 
                "${workspaceFolder}/build/oocd_tool.cfg", 
                "${workspaceFolder}/build/oocd_mcu.cfg"
            ]
		},
        {
            "label": "Stop remoute OpenOCD",
            "type": "shell",
            "group": "build",
            "command": "python",
            "args": ["${workspaceFolder}/Tools/remoute_gdb_launch.py", "--stop"],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
